# Clé API Anthropic (obligatoire)
# Obtenir sur : https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Redis Upstash (optionnel — compteur de questions + rate limiting partagé)
# Créé automatiquement via Vercel → Storage → Upstash Redis
KV_REST_API_URL=https://...upstash.io
KV_REST_API_TOKEN=...

# Plafond global de questions par jour, toutes IP confondues (optionnel, défaut : 2000)
# Protège le budget API en cas d'abus distribué
DAILY_LIMIT=2000

# Le system prompt du chatbot est dans prompts/system-prompt.txt (versionné avec le code)
